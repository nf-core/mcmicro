nextflow_workflow {

    name "Test Workflow PRELUDE"
    script "../main.nf"
    workflow "PRELUDE"

    [
        test("normal run") {
            setup {
                run("BFTOOLS_SHOWINF") {
                    script "modules/nf-core/bftools/showinf/main.nf"
                    process {
                        """
                        input[0] = [["id": 0], file(params.modules_testdata_base_path + "/imaging/ome-tiff/cycif-tonsil-cycle1.ome.tif")]
                        """
                    }
                }
            }
            when {
                workflow {
                    """
                     input[0] = Channel.of([
                                [
                                    channel_number:1,
                                    cycle_number:1,
                                    marker_name:'DNA_6',
                                    filter:null,
                                    excitation_wavelength:null,
                                    emission_wavelength:null,
                                    exposure:null,
                                    background:null,
                                    remove:null,
                                    exposure_time:null,
                                    exposure_time_unit:null
                                ],],
                            )
                     input[1] = Channel.of(
                            [
                                [id:"TEST1", cycle_number:1, channel_count:4],
                                "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/imaging/ome-tiff/cycif-tonsil-cycle1.ome.tif",
                                [],
                                [],
                            ],)
                     input[2] = BFTOOLS_SHOWINF.out.xml
                    """
                }
            }

            then {
                assertAll(
                    { assert workflow.success },
                    { assert snapshot(workflow.out).match() }
                )
            }
        },
    ]
}
