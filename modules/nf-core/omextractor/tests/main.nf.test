nextflow_process {

    name "Test Process omextractor"
    script "main.nf"
    process "omextractor"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = file(params.modules_testdata_base_path + "../../../exemplar-001.ome.tif", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
