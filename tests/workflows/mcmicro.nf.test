nextflow_workflow {

    name "test mcmicro workflow"
    script "workflows/mcmicro.nf"
    workflow "MCMICRO"

    test("test 1") {

        when {
            params {
                outdir = "$outputDir"
                segmentation = "mccellpose"
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [id:"TEST1", cycle_number:1],
                        "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/imaging/ome-tiff/cycif-tonsil-cycle1.ome.tif",
                        [],
                        [],
                    ],
                )
                input[1] = Channel.of(
                    [
                        [channel_number: 1, cycle_number: 1, marker_name: 'DNA 1'],
                        [channel_number: 2, cycle_number: 1, marker_name: 'Na/K ATPase'],
                        [channel_number: 3, cycle_number: 1, marker_name: 'CD3'],
                        [channel_number: 4, cycle_number: 1, marker_name: 'CD45RO'],
                    ],
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out.versions).match("versions") }
            )
        }

    }

    test("test prelude") {

        when {
            params {
                outdir = "$outputDir"
                segmentation = "mccellpose"
                prelude = true
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [id:"TEST1", cycle_number:1, channel_count:4],
                        "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/imaging/ome-tiff/cycif-tonsil-cycle1.ome.tif",
                        [],
                        [],
                    ],
                )
                input[1] = Channel.of(
                    [
                        [channel_number: 1, cycle_number: 1, marker_name: 'DNA 1'],
                        [channel_number: 2, cycle_number: 1, marker_name: 'Na/K ATPase'],
                        [channel_number: 3, cycle_number: 1, marker_name: 'CD3'],
                        [channel_number: 4, cycle_number: 1, marker_name: 'CD45RO'],
                    ],
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.versions.size() == 1 }
            )
        }

    }

    test("Invalid xml parameters - must fail") {
        when {
            params {
                prelude = true
            }
            workflow {
                """
                 input[0] = Channel.of(
                    [
                        [id:"TEST1", cycle_number:1, channel_count:4],
                        "${projectDir}/assets/test.bad.ome.tiff",
                        [],
                        [],
                    ],
                    [
                        [id:"TEST1", cycle_number:2, channel_count:4],
                        "${projectDir}/assets/test.bad.ome.tiff",
                        [],
                        [],
                    ],
                )
                input[1] = Channel.of(
                    [
                        [channel_number: 1, cycle_number: 1, marker_name: 'DNA 1'],
                        [channel_number: 2, cycle_number: 1, marker_name: 'Na/K ATPase'],
                        [channel_number: 3, cycle_number: 1, marker_name: 'CD3'],
                        [channel_number: 4, cycle_number: 1, marker_name: 'CD45RO'],
                        [channel_number: 5, cycle_number: 2, marker_name: 'DNA 11'],
                        [channel_number: 6, cycle_number: 2, marker_name: 'Na/K ATPase1'],
                        [channel_number: 7, cycle_number: 2, marker_name: 'CD31'],
                        [channel_number: 8, cycle_number: 2, marker_name: 'CD45RO1'],
                    ],
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                //{ assert workflow.exitStatus == 0 },
                { assert workflow.errorReport.contains("QC Error found") }
            )
        }
    }
}
