                            CsvUtils.summarizeCsv("$outputDir/quantification/mcquant/mesmer/TEST1.backsub_mask_TEST1.csv"),
                            path("$outputDir/backsub/TEST1.backsub.ome.tif"),
                        ).match()
                    },
                    { assert workflow.success }
                )
            }

        },

    ]
}
