                            ImageUtils.getImageMetadata("$outputDir/illumination_correction/basicpy/TEST1_1-dfp.ome.tif"),
                            ImageUtils.getImageMetadata("$outputDir/illumination_correction/basicpy/TEST1_1-ffp.ome.tif"),
                            removeNextflowVersion("$outputDir/pipeline_info/nf_core_mcmicro_software_mqc_versions.yml"),
