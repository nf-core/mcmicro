                            CsvUtils.summarizeCsv("$outputDir/quantification/mcquant/mesmer/1_TEST1_1_mask.csv"),
                            removeNextflowVersion("$outputDir/pipeline_info/nf_core_mcmicro_software_mqc_versions.yml"),
                        ).match()
                    },
                    { assert workflow.success }
                )
            }
        },

        test("cycle: no illumination correction, backsub") {

            when {
                params {
                    outdir = "$outputDir"
                    segmentation = "mccellpose"
                    backsub = true
                }
                workflow {
                    """
                    input[0] = Channel.of(
                        [
                            [id:"TEST1", cycle_number:1],
                            "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/imaging/ome-tiff/cycif-tonsil-cycle1.ome.tif",
                            [],
                            [],
                        ],
                        [
                            [id:"TEST1", cycle_number:2],
                            "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/imaging/ome-tiff/cycif-tonsil-cycle2.ome.tif",
                            [],
                            [],
                        ],
                    )
                    input[1] = Channel.of(
                        [
                            [channel_number: 1, cycle_number: 1, marker_name: 'DNA 1'],
                            [channel_number: 2, cycle_number: 1, marker_name: 'Na/K ATPase', exposure: 100],
                            [channel_number: 3, cycle_number: 1, marker_name: 'CD3', exposure: 100, background: 'Na/K ATPase'],
                            [channel_number: 4, cycle_number: 1, marker_name: 'CD45RO'],
                            [channel_number: 5, cycle_number: 2, marker_name: 'DNA 2', remove: true],
                            [channel_number: 6, cycle_number: 2, marker_name: 'Antigen Ki67'],
                            [channel_number: 7, cycle_number: 2, marker_name: 'Pan-cytokeratin'],
                            [channel_number: 8, cycle_number: 2, marker_name: 'Aortic smooth muscle actin']
                        ],
                    )
                    """
                }
            }

            then {
                assertAll (
                    {
                        assert snapshot (
                            path("$outputDir/registration/ashlar/TEST1.ome.tif"),
                            ImageUtils.getImageMetadata("$outputDir/backsub/TEST1_backsub.ome.tif"),
                            ImageUtils.getImageMetadata("$outputDir/segmentation/mccellpose/TEST1_mask.ome.tif"),
                            CsvUtils.summarizeCsv("$outputDir/quantification/mcquant/mccellpose/TEST1.csv")
                                .collectEntries(CsvUtils.checkRowCount(2100, 2150)),
                            removeNextflowVersion("$outputDir/pipeline_info/nf_core_mcmicro_software_mqc_versions.yml"),
                        ).match()
                    },
                    { assert workflow.success }
                )
            }

        },

    ]
}
