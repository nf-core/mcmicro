{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/mcmicro/master/assets/schema_marker.json",
    "title": "nf-core/mcmicro pipeline - params.marker_sheet schema",
    "description": "Schema for the file provided with params.marker_sheet",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "channel_number": {
                "type": "integer",
                "minimum": 1,
                "errorMessage": "channel_number must be provided",
                "meta": "channel_number"
            },
            "cycle_number": {
                "type": "integer",
                "minimum": 1,
                "errorMessage": "cycle_number must be provided",
                "meta": "cycle_number"
            },
            "marker_name": {
                "type": "string",
                "pattern": "\\S",
                "errorMessage": "marker_name must be provided",
                "meta": "marker_name"
            },
            "filter": {
                "type": "string",
                "default": null,
                "pattern": "\\S",
                "errorMessage": "",
                "meta": "filter"
            },
            "excitation_wavelength": {
                "type": "integer",
                "default": null,
                "errorMessage": "",
                "meta": "excitation_wavelength"
            },
            "emission_wavelength": {
                "type": "integer",
                "default": null,
                "errorMessage": "",
                "meta": "emission_wavelength"
            },
            "exposure": {
                "type": "number",
                "default": null,
                "minimum": 0.001,
                "errorMessage": "Exposure time must be a positive number.",
                "meta": "exposure"
            },
            "background": {
                "type": "string",
                "default": null,
                "pattern": "\\S",
                "meta": "background"
            },
            "remove": {
                "type": "boolean",
                "default": null,
                "meta": "remove"
            }
        },
        "required": ["channel_number", "cycle_number", "marker_name"]
    }
}
